{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "build:pages": "npm run content:build && node scripts/build_pages.mjs",
    "check:export": "node --experimental-strip-types scripts/check_export.mjs",
    "lint": "eslint app scripts next.config.ts",
    "content:build": "npm run content:prepare && node scripts/content.mjs",
    "content:check": "npm run content:prepare && node scripts/content.mjs --check",
    "test:content": "node --test scripts/content.test.mjs scripts/prepare-content.test.mjs scripts/snapshot.test.mjs scripts/bibliography.test.mjs scripts/markdown-content.test.mjs scripts/dataset-content.test.mjs",
    "prebuild": "npm run content:build",
    "content:prepare": "node scripts/prepare-content.mjs --validate",
    "predev": "npm run content:prepare",
    "pretest:content": "npm run content:prepare",
    "snapshot:update": "npm run content:prepare && node scripts/snapshot.mjs --update",
    "snapshot:check": "node scripts/snapshot.mjs",
    "test:snapshot": "node --test scripts/snapshot.test.mjs"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@retorquere/bibtex-parser": "^11.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "^6.15.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "js-yaml": "^4.3.2",
    "nestedtext": "^1.2.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "type": "module"
}
