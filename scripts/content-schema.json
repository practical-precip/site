{
  "definitions": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "expert-reviewed"
          ]
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "status",
        "contributors",
        "updated"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "expert-reviewed"
              }
            }
          },
          "then": {
            "required": [
              "reviewed_by",
              "reviewed_on"
            ]
          }
        }
      ]
    },
    "evidence": {
